# Intentionally ignored by GitHub Actions because this file does not end in
# .yml or .yaml. Rename it only after Windows startup has passed real-device
# validation and a Windows signing policy has been chosen.
name: Windows Release

on:
  push:
    tags: ["v*"]

permissions:
  contents: write

jobs:
  windows-x64:
    runs-on: macos-14
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22.23.2
          cache: npm
      - run: npm ci --ignore-scripts
      - run: npm run check
      - name: Install the cross-compiler
        run: brew install mingw-w64
      - name: Validate tag and build Windows x64
        shell: bash
        run: |
          version="$(node scripts/validate-release-tag.mjs "$GITHUB_REF_NAME")"
          node scripts/build-windows-release.mjs --arch x64 --version "$version"
      - name: Verify ZIP checksum
        run: (cd dist && shasum -a 256 -c ./*.sha256)
      - name: Upload Windows asset to the matching release
        env:
          GH_TOKEN: ${{ github.token }}
        run: gh release upload "$GITHUB_REF_NAME" dist/*.zip dist/*.sha256 --clobber
