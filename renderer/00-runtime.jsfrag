  if (
    window[GLOBAL_KEY]?.version === VERSION &&
    window[GLOBAL_KEY]?.revision === RENDERER_REVISION
  ) return VERSION;
  try {
    window[GLOBAL_KEY]?.destroy?.();
  } catch {}

  let localeOverride;
  let localeSettingLoaded = false;

  const state = {
    snapshots: readSnapshotCache(),
    spawns: new Map(),
